{
  "name": "bankinvest-server",
  "version": "1.0.0",
  "private": true,
  "description": "Единый сервер для веб-версии и десктопной версии BankInvest: REST API + веб-приложение + Microsoft SQL Server",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
